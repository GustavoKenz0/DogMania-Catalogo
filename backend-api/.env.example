# Reference only. Spring Boot does NOT automatically load this file.
# Set these variables in your IDE/run configuration or deployment secrets.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/postgres?sslmode=verify-full
SUPABASE_DB_USER=dogmania_api
SUPABASE_DB_PASSWORD=
JWT_SECRET_KEY=
JWT_EXPIRATION_MS=3600000
CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
SERVER_PORT=8080
API_DOCS_ENABLED=false

# First administrator only. Disable and remove password after first successful run.
DOGMANIA_BOOTSTRAP_ADMIN_ENABLED=false
DOGMANIA_BOOTSTRAP_ADMIN_EMAIL=
DOGMANIA_BOOTSTRAP_ADMIN_PASSWORD=

# Optional uploads. Never expose service-role credentials to the front-end.
STORAGE_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
